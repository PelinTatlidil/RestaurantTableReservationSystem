    {
      "name": "Get available time slots",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let response = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is an array\", function () {",
              "    pm.expect(response).to.be.an(\"array\");",
              "});",
              "",
              "if (response.length > 0) {",
              "    pm.environment.set(\"time_slot_id\", response[0]._id);",
              "    pm.environment.set(\"time_slot_label\", response[0].startTime + \" - \" + response[0].endTime);",
              "",
              "    console.log(\"Saved time slot:\", response[0].startTime + \" - \" + response[0].endTime);",
              "    console.log(\"Saved time_slot_id:\", response[0]._id);",
              "} else {",
              "    console.warn(\"No available time slots found\");",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://52.65.216.208:5001/api/time-slots/available",
          "protocol": "http",
          "host": [
            "52",
            "65",
            "216",
            "208"
          ],
          "port": "5001",
          "path": [
            "api",
            "time-slots",
            "available"
          ]
        },
        "description": "This is a GET request and it is used to \"get\" data from an endpoint. There is no request body for a GET request, but you can use query parameters to help specify the resource you want data on (e.g., in this request, we have `id=1`).\n\nA successful GET response will have a `200 OK` status, and should include some kind of response body - for example, HTML web content or JSON data."
      },
      "response": []
    },
    {
      "name": "Login as a customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse the response body",
              "let response = pm.response.json();",
              "",
              "// Basic test: status code should be 200",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Body contains token\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"token\");",
              "});",
              "",
              "pm.test(\"Body contains customer role\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"customer\");",
              "});",
              "",
              "pm.test(\"Content-Type is present\", function () {",
              "    pm.response.to.have.header(\"Content-Type\");",
              "});",
              "",
              "pm.test(\"Response time is less than 200ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(200);",
              "});",
              "",
              "// Save JWT token to environment variable",
              "if (response.token) {",
              "    pm.environment.set(\"jwt_token\", response.token);",
              "    console.log(\"JWT Token saved to environment\");",
              "} else {",
              "    console.warn(\"No token found in response!\");",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customer_email}}\",\n  \"password\": \"{{customer_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
