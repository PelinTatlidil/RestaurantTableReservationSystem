    {
      "name": "Create a reservation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let response = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Reservation was confirmed\", function () {\r",
              "    pm.expect(response.message).to.eql(\"Reservation confirmed successfully\");\r",
              "});\r",
              "\r",
              "pm.test(\"Reservation ID is returned\", function () {\r",
              "    pm.expect(response.reservation._id).to.exist;\r",
              "});\r",
              "\r",
              "if (response.reservation && response.reservation._id) {\r",
              "    pm.environment.set(\"reservation_id\", response.reservation._id);\r",
              "    console.log(\"Reservation ID saved:\", response.reservation._id);\r",
              "}"
